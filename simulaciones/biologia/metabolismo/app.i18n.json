\", \u00276 NADH + 2 FADH₂ + 2 GTP\u0027) + row(\u0027Total\u0027, \u002710 NADH + 2 FADH₂\u0027) + \u0027\u003c/table\u003e\u003cdiv class=\"calc-step\"\u003e2 · ATP\u003c/div\u003e\u003ctable class=\"calc-table\"\u003e\u0027 + row(\"Substrate-level phosphorylation\", \u00272 + 2 = 4\u0027) + row(\u002710 × 2,5 + 2 × 1,5\u0027, \u002728\u0027) + row(\"Aerobic total\", \u002732 ATP\u0027) + row(\"Chosen condition\", fmt(Y.tot, 1) + \u0027 ATP\u0027) + \"\u003c/table\u003e\u003cdiv class=\\\"calc-step\\\"\u003e3 · Thermodynamics\u003c/div\u003e\u003ctable class=\\\"calc-table\\\"\u003e\" + row(\"ΔG°′ = −nFΔE (n = 2, ΔE = 1.14 V)\", fmt(-2 * 96.485 * 1.14, 0) + \u0027 kJ/mol\u0027) + row(\"Efficiency 32 × 50 / 2,870\", fmt(32 * 50 / 2870 * 100, 0) + \u0027 %\u0027) + \u0027\u003c/table\u003e\u0027; },"],"      ui.v = kit.ui.options({ label: \u0027Etapa\u0027, cols: 3, value: String(S.v), options: [[\u00270\u0027, \u0027General\u0027], [\u00271\u0027, \u0027Glucólisis\u0027], [\u00272\u0027, \u0027Krebs\u0027], [\u00273\u0027, \u0027Cadena\u0027], [\u00274\u0027, \u0027Balance\u0027]].map(function (o) { return { v: o[0], label: o[1] }; }), onChange: function (v) { ctx.goManual(); S.v = +v; S.ph = 0; } }); c.appendChild(ui.v);":["      ui.v = kit.ui.options({ label: \"Stage\", cols: 3, value: String(S.v), options: [[\u00270\u0027, \"General\"], [\u00271\u0027, \"Glycolysis\"], [\u00272\u0027, \"Krebs\"], [\u00273\u0027, \"Chain\"], [\u00274\u0027, \"Balance\"]].map(function (o) { return { v: o[0], label: o[1] }; }), onChange: function (v) { ctx.goManual(); S.v = +v; S.ph = 0; } }); c.appendChild(ui.v);"],"    [\u0027Cadena respiratoria\u0027, \u0027Cadena\u0027, \u0027NADH → CI → Q → CIII → cit c → CIV → O₂\u0027, \u0027\u003cp\u003eLos electrones del NADH (−0,32 V) caen hasta el O₂ (+0,82 V). \u003cb\u003eCI, CIII y CIV bombean H⁺\u003c/b\u003e al espacio intermembrana, creando el \u003cb\u003egradiente protónico\u003c/b\u003e (Δp). Los H⁺ regresan por la \u003cb\u003eATP sintasa\u003c/b\u003e, cuyo rotor impulsa la síntesis de ATP (\u003cb\u003equimiosmosis\u003c/b\u003e, Mitchell).\u003c/p\u003e\u0027],":["    [\"Respiratory chain\", \"Chain\", \"NADH → CI → Q → CIII → cyt c → CIV → O₂\", \"\u003cp\u003eThe electrons of NADH (−0.32 V) fall down to O₂ (+0.82 V). \u003cb\u003eCI, CIII and CIV pump H⁺\u003c/b\u003e into the intermembrane space, creating the \u003cb\u003eproton gradient\u003c/b\u003e (Δp). The H⁺ return through \u003cb\u003eATP synthase\u003c/b\u003e, whose rotor drives ATP synthesis (\u003cb\u003echemiosmosis\u003c/b\u003e, Mitchell).\u003c/p\u003e\"],"],"    [\u0027Glucólisis\u0027, \u0027Glucólisis\u0027, \u0027C₆H₁₂O₆ + 2 NAD⁺ + 2 ADP + 2 Pᵢ → 2 piruvato + 2 NADH + 2 ATP\u0027, \u0027\u003cp\u003eDiez reacciones: la fase de \u003cb\u003einversión\u003c/b\u003e gasta 2 ATP (hexocinasa, PFK-1); la fase de \u003cb\u003ebeneficio\u003c/b\u003e produce 4 ATP y 2 NADH. \u003cb\u003eRendimiento neto: 2 ATP + 2 NADH\u003c/b\u003e por glucosa. Sin O₂, el piruvato se reduce a \u003cb\u003elactato\u003c/b\u003e para regenerar NAD⁺.\u003c/p\u003e\u0027],":["    [\"Glycolysis\", \"Glycolysis\", \"C₆H₁₂O₆ + 2 NAD⁺ + 2 ADP + 2 Pᵢ → 2 pyruvate + 2 NADH + 2 ATP\", \"\u003cp\u003eTen reactions: the \u003cb\u003einvestment\u003c/b\u003e phase spends 2 ATP (hexokinase, PFK-1); the \u003cb\u003epayoff\u003c/b\u003e phase produces 4 ATP and 2 NADH. \u003cb\u003eNet yield: 2 ATP + 2 NADH\u003c/b\u003e per glucose. Without O₂, pyruvate is reduced to \u003cb\u003elactate\u003c/b\u003e to regenerate NAD⁺.\u003c/p\u003e\"],"],"    help: { intro: \u0027Usa «Lab» para elegir la etapa, el inhibidor y la presencia de O₂.\u0027, items: [[\u0027Glucólisis\u0027, \u0027diez pasos con ATP neto y NADH.\u0027], [\u0027Krebs\u0027, \u0027anillo con carbonos y descarboxilaciones.\u0027], [\u0027Cadena\u0027, \u0027bomba de H⁺ y ATP sintasa; prueba inhibidores.\u0027], [\u0027Balance\u0027, \u0027compara el ATP de cada condición.\u0027], [\u0027Colores\u0027, \u0027las esferas distinguen carbonos, ATP (energía), protones (H⁺) y electrones (e⁻).\u0027], [\u0027Controles\u0027, \u0027«Etapa», «Inhibidor», «Oxígeno» (con o sin O₂) y «Avance».\u0027], [\u0027Gráficos\u0027, \u0027ATP por glucosa según la condición, torre redox de la cadena respiratoria y balance energético de la oxidación de la glucosa.\u0027]], try: [\u0027En la cadena respiratoria quita el O₂: la cadena se detiene y la glucólisis regenera NAD⁺ formando lactato.\u0027, \u0027Aplica un desacoplante: sube el consumo de O₂, pero baja el ATP.\u0027, \u0027Compara en el gráfico el ATP por glucosa con y sin O₂.\u0027] }":["    help: { intro: \"Use “Lab” to choose the stage, the inhibitor and the presence of O₂.\", items: [[\"Glycolysis\", \"ten steps with net ATP and NADH.\"], [\"Krebs\", \"ring with carbons and decarboxylations.\"], [\"Chain\", \"H⁺ pump and ATP synthase; try inhibitors.\"], [\"Balance\", \"compare the ATP of each condition.\"], [\u0027Colours\u0027, \u0027the spheres distinguish carbons, ATP (energy), protons (H⁺) and electrons (e⁻).\u0027], [\u0027Controls\u0027, \u0027stage, inhibitor, oxygen (with or without O₂) and progress.\u0027], [\u0027Charts\u0027, \u0027ATP per glucose by condition, redox tower of the respiratory chain and energy balance of glucose oxidation.\u0027]], try: [\u0027In the respiratory chain remove O₂: the chain stops and glycolysis regenerates NAD⁺ by forming lactate.\u0027, \u0027Apply an uncoupler: O₂ consumption rises but ATP falls.\u0027, \u0027Compare ATP per glucose with and without O₂ on the chart.\u0027] }"],"    if (inh === \u0027dnp\u0027) { k = 2; ox = 0; g = 2; }":["    if (inh === \u0027dnp\u0027) { k = 2; ox = 0; g = 2; }"],"    return { g: g, k: k, ox: ox, tot: g + k + ox + (inh === \u0027dnp\u0027 ? 0 : 0), lact: false };":["    return { g: g, k: k, ox: ox, tot: g + k + ox + (inh === \u0027dnp\u0027 ? 0 : 0), lact: false };"],"    views: [{ id: \u0027libre\u0027, label: \u0027Libre\u0027, pos: [0, 1.5, 13], target: [0, 0, 0] }, { id: \u0027frontal\u0027, label: \u0027Frontal\u0027, pos: [0, 0, 14], target: [0, 0, 0] }, { id: \u0027sup\u0027, label: \u0027Superior\u0027, pos: [0, 13, 0.5], target: [0, 0, 0] }],":["    views: [{ id: \u0027libre\u0027, label: \"Free\", pos: [0, 1.5, 13], target: [0, 0, 0] }, { id: \u0027frontal\u0027, label: \"Front\", pos: [0, 0, 14], target: [0, 0, 0] }, { id: \u0027sup\u0027, label: \"Top\", pos: [0, 13, 0.5], target: [0, 0, 0] }],"],"  function lessonSet(i, loc) { S.v = i; if (i === 4) { var q = Math.floor(loc * 5); S.inh = [\u0027none\u0027, \u0027rot\u0027, \u0027cn\u0027, \u0027oli\u0027, \u0027dnp\u0027][Math.min(4, q)]; S.o2 = true; } else { S.inh = \u0027none\u0027; S.o2 = true; } S.ph = loc; }":["  function lessonSet(i, loc) { S.v = i; if (i === 4) { var q = Math.floor(loc * 5); S.inh = [\u0027none\u0027, \u0027rot\u0027, \u0027cn\u0027, \u0027oli\u0027, \u0027dnp\u0027][Math.min(4, q)]; S.o2 = true; } else { S.inh = \u0027none\u0027; S.o2 = true; } S.ph = loc; }"]},"keep":["\u0027\u003c/table\u003e\u003cdiv class=\"calc-step\"\u003e2 · ATP\u003c/div\u003e\u003ctable class=\"calc-table\"\u003e\u0027","\u0027\u003cdiv class=\"eqline\"\u003e\u003csmall\u003e\u0027","\u002710px system-ui\u0027","\u002711px system-ui\u0027"]}