l: \"Blue\", color: \u0027#4263eb\u0027, text: \"K⁺ channel\" }, { label: \"Ring\", color: \u0027#4dabf7\u0027, text: \"local voltage (blue → red)\" }] }; },"],"    views: [{ id: \u0027libre\u0027, label: \u0027Libre\u0027, pos: [16, 6, 20], target: [16, 0, 0] }, { id: \u0027frontal\u0027, label: \u0027Frontal\u0027, pos: [16, 2, 24], target: [16, 0, 0] }],":["    views: [{ id: \u0027libre\u0027, label: \"Free\", pos: [16, 6, 20], target: [16, 0, 0] }, { id: \u0027frontal\u0027, label: \"Front\", pos: [16, 2, 24], target: [16, 0, 0] }],"]},"keep":["\u002710px system-ui\u0027"]}