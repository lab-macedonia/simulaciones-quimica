 [[\"Polymer\", q.n], [\"Mechanism\", q.k === \u0027a\u0027 ? \"addition\" : \"condensation\"], [\"M₀ (unit)\", fmt(q.M, 2) + \" g/mol\"], [\u0027Xn\u0027, q.k === \u0027a\u0027 ? String(S.n) : fmt(Xn(), 1)], [\u0027Mn\u0027, fmt(Mn(), 0) + \" g/mol\"], [\"Đ (Mw/Mn)\", fmt(disp(), 2)], [\"Approx. Tg\", q.tg + \u0027 °C\u0027], [\u0027Usos\u0027, q.use]]; },"],"    views: [{ id: \u0027libre\u0027, label: \u0027Libre\u0027, pos: [6, 6, 22], target: [6, 0, 0] }, { id: \u0027frontal\u0027, label: \u0027Frontal\u0027, pos: [6, 0, 26], target: [6, 0, 0] }],":["    views: [{ id: \u0027libre\u0027, label: \"Free\", pos: [6, 6, 22], target: [6, 0, 0] }, { id: \u0027frontal\u0027, label: \"Front\", pos: [6, 0, 26], target: [6, 0, 0] }],"]},"keep":["\u0027\u003cdiv class=\"card-kicker\"\u003e\u0027","\u002710px system-ui\u0027"]}