\u0027 }, legend: [{ label: \"Orange\", color: \u0027#e8590c\u0027, text: \"Fe²⁺ dissolving\" }, { label: \"Cyan\", color: \u0027#22b8cf\u0027, text: \"OH⁻ at the cathode\" }, { label: \"Yellow\", color: \u0027#ffd43b\u0027, text: \"electrons\" }] }; },"],"    layers: [{ id: \u0027e\u0027, label: \u0027Electrones\u0027, icon: \u0027e⁻\u0027 }, { id: \u0027ion\u0027, label: \u0027Iones\u0027, icon: \u0027±\u0027 }],":["    layers: [{ id: \u0027e\u0027, label: \"Electrons\", icon: \u0027e⁻\u0027 }, { id: \u0027ion\u0027, label: \"Ions\", icon: \u0027±\u0027 }],"],"    views: [{ id: \u0027libre\u0027, label: \u0027Libre\u0027, pos: [13, 10, 15], target: [13, 0, 0] }, { id: \u0027lateral\u0027, label: \u0027Lateral\u0027, pos: [13, 2, 22], target: [13, 1, 0] }],":["    views: [{ id: \u0027libre\u0027, label: \"Free\", pos: [13, 10, 15], target: [13, 0, 0] }, { id: \u0027lateral\u0027, label: \"Side\", pos: [13, 2, 22], target: [13, 1, 0] }],"]},"keep":["\u0027 V\u003c/div\u003e\u003cdiv class=\"eqline\"\u003e\u003csmall\u003eΔE\u003c/small\u003e\u0027","\u0027\u003c/div\u003e\u003ctable class=\"calc-table\"\u003e\u0027","\u0027\u003cdiv class=\"card-kicker\"\u003e\u0027","\u002710px system-ui\u0027"]}